source "${SCRIPT_DIR}/m2lib"

export WD=${MARTe2_ACTIVE_PROJECT}/Startup
export CFG_DIR=${MARTe2_ACTIVE_PROJECT}/Configurations

config=$(find_config "$1")
shift

mapfile -t realtime_states < <(find_realtime_states "$config")

for state in "${realtime_states[@]}"; do
    echo "RealTimeState: $state"
done
